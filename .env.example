# =============================================================================
# KRONABEL WEBSITE & CMS - ENVIRONMENT VARIABLES TEMPLATE
# Salin berkas ini menjadi .env.local untuk pengujian lokal,
# dan tambahkan variabel ini ke Dashboard Environment Variables Vercel.
# =============================================================================

# 1. Supabase Project URL (Ditemukan di: Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Key (Ditemukan di: Project Settings -> API -> anon/public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 3. Supabase Service Role Key (Ditemukan di: Project Settings -> API -> service_role secret key)
# PERINGATAN: Variabel ini hanya boleh diakses di lingkungan Server (API route/Server Action),
# JANGAN PERNAH menambahkan prefix NEXT_PUBLIC_ pada variabel ini!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 4. Kunci Inisialisasi Admin Pertama Kali (Bootstrap Secret Token)
# Digunakan untuk melindungi endpoint inisialisasi /api/admin/setup dari akses sembarangan
ADMIN_SETUP_SECRET=ganti-dengan-token-rahasia-panjang-dan-acak-anda

